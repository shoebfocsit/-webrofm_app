default_platform(:ios)

platform :ios do
  desc "Fetch certificates, profile, build and upload to TestFlight"

  lane :setup_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # Automatically creates or fetches distribution certificate into keychain
    get_certificates(
      api_key: api_key,
      output_path: "/tmp/certs"
    )

    # Automatically downloads or creates App Store provisioning profile and installs it
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.webrofm.webrofm",
      output_path: "/tmp/profiles"
    )
  end

  lane :upload_testflight do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    upload_to_testflight(
      ipa: options[:ipa],
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
