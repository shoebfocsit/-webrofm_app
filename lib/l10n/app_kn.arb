  "helpFaqOther": "ಇತರೆ",
  "helpFaq1Q": "ನನ್ನ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಾನು ಹೇಗೆ ಮರುಹೊಂದಿಸುವುದು?",
  "helpFaq1A": "ಲಾಗಿನ್ ಪರದೆಯಿಂದ 'ಪಾಸ್‌ವರ್ಡ್ ಮರೆತಿರಾ' ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಮರುಹೊಂದಿಸಬಹುದು. ನಿಮ್ಮ ನೋಂದಾಯಿತ ಇಮೇಲ್ ಅಥವಾ ಫೋನ್‌ಗೆ ಕಳುಹಿಸಲಾದ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ.",
  "helpFaq2Q": "ನಾನು ನನ್ನ ಚಂದಾದಾರಿಕೆ ಯೋಜನೆಯನ್ನು ಬದಲಾಯಿಸಬಹುದೇ?",
  "helpFaq2A": "ಹೌದು, ನಿಮ್ಮ ಪ್ರಸ್ತುತ ಯೋಜನೆಯನ್ನು ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸೆಟ್ಟಿಂಗ್ಗಳು > ಚಂದಾದಾರಿಕೆಗೆ ಹೋಗಿ. ಬದಲಾವಣೆಗಳು ಮುಂದಿನ ಬಿಲ್ಲಿಂಗ್ ಸೈಕಲ್‌ನಿಂದ ಜಾರಿಗೆ ಬರುತ್ತವೆ.",
  "helpFaq3Q": "ನನ್ನ ಖಾತೆಯನ್ನು ನಾನು ಹೇಗೆ ಅಳಿಸುವುದು?",
  "helpFaq3A": "ಸೆಟ್ಟಿಂಗ್ಗಳು > ಅಪಾಯ ವಲಯ > ನನ್ನ ಖಾತೆಯನ್ನು ಅಳಿಸಿ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ. ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲು ಪರಿಶೀಲನೆ ಹಂತಗಳನ್ನು ಅನುಸರಿಸಿ.",
  "helpFaq4Q": "ನನ್ನ ಡೌನ್ಲೋಡ್ ಮಾಡಿದ ಫೈಲ್ಗಳು ಎಲ್ಲಿವೆ?",
  "helpFaq4A": "ಡೌನ್ಲೋಡ್ ಮಾಡಿದ ಸಂಚಿಕೆಗಳನ್ನು ಅಪ್ಲಿಕೇಶನ್ ಒಳಗೆ ನನ್ನ ಡೌನ್ಲೋಡ್ಗಳ ಅಡಿಯಲ್ಲಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ. ಅವು ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಕೇಳಲು ಲಭ್ಯವಿರುತ್ತವೆ.",
  "helpFaq5Q": "ನನ್ನ ಪ್ರೊಫೈಲ್ ಮಾಹಿತಿಯನ್ನು ನಾನು ಹೇಗೆ ನವೀಕರಿಸುವುದು?",
  "helpFaq5A": "ನಿಮ್ಮ ಹೆಸರು, ಇಮೇಲ್, ಹುಟ್ಟಿದ ದಿನಾಂಕ ಮತ್ತು ಪ್ರೊಫೈಲ್ ಚಿತ್ರವನ್ನು ನವೀಕರಿಸಲು ಪ್ರೊಫೈಲ್ > ಪ್ರೊಫೈಲ್ ಸಂಪಾದಿಸಿ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ.",
  "helpFaq6Q": "ನನ್ನ ಆಡಿಯೊ ಏಕೆ ಪ್ಲೇ ಆಗುತ್ತಿಲ್ಲ?",
  "helpFaq6A": "ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಲು ಪ್ರಯತ್ನಿಸಿ. ಸಮಸ್ಯೆ ಮುಂದುವರಿದರೆ, ಸೆಟ್ಟಿಂಗ್ಗಳಿಂದ ಅಪ್ಲಿಕೇಶನ್ ಕ್ಯಾಷ್ ಅನ್ನು ತೆರವುಗೊಳಿಸಲು ಪ್ರಯತ್ನಿಸಿ.",
  "helpFaq7Q": "ನಾನು ಹೇಗೆ ಮರುಪಾವತಿ ಪಡೆಯುವುದು?",
  "helpFaq7A": "ನಿಮ್ಮ ವಹಿವಾಟು ವಿವರಗಳೊಂದಿಗೆ support@webrofm.com ನಲ್ಲಿ ನಮ್ಮ ಬೆಂಬಲ ತಂಡವನ್ನು ಸಂಪರ್ಕಿಸಿ. ನಾವು 5-7 ಕೆಲಸದ ದಿನಗಳಲ್ಲಿ ನಿಮ್ಮ ಮರುಪಾವತಿಯನ್ನು ಪ್ರಕ್ರಿಯೆಗೊಳಿಸುತ್ತೇವೆ.",
  "helpFaq8Q": "ದೋಷವನ್ನು ನಾನು ಹೇಗೆ ವರದಿ ಮಾಡುವುದು?",
  "helpFaq8A": "ಸೆಟ್ಟಿಂಗ್ಗಳಲ್ಲಿನ ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ ವಿಭಾಗದ ಮೂಲಕ ದೋಷಗಳನ್ನು ವರದಿ ಮಾಡಬಹುದು. ಸಮಸ್ಯೆಯನ್ನು ಪುನರುತ್ಪಾದಿಸುವ ಹಂತಗಳು ಮತ್ತು ನಿಮ್ಮ ಸಾಧನ ಮಾಹಿತಿಯನ್ನು ಸೇರಿಸಿ.",
  "privacyPolicyTitle": "ಗೌಪ್ಯತಾ ನೀತಿ",
